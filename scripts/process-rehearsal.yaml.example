audio:
  mp3_bitrate: "320k"

tracks:
  per_track:

    "01 BASS":
      effects:
        - type: normalize
        - type: compress
          preset: "Brick Wall Master"
          threshold: -13
          label: "Ecrête les mutes un peu trop sonores"
        - type: normalize
        - type: compress
          preset: "Bass Guitar"
          label: "Donne du corps"
        - type: normalize

    "02 GUIT DI":
      effects:
        - type: normalize
        - type: compress
          preset: "Gentle"
        - type: gain
          db: -8

    "03 GUIT MIC":
      effects:
        - type: normalize
        - type: compress
          preset: "Gentle"
        - type: gain
          db: -14

    "04 KEYS L":
      effects:
        - type: normalize
        - type: gain
          db: -14

    "05 KEYS R":
      effects:
        - type: normalize
        - type: gain
          db: -14

    "06 RHODES L":
      effects:
        - type: normalize
        - type: gain
          db: -14

    "07 RHODES R":
      effects:
        - type: normalize
        - type: gain
          db: -14

    "10 SAMPLER":
      effects:
        - type: normalize
        - type: gain
          db: -6
          label: "En retrait dans le mix batterie — peu utilisé par le batteur"

    "18 BACK VOCALS":
      effects:
        - type: normalize
        - type: compress
          preset: "Brick Wall Master"
          threshold: -13
          label: "Ecrête les bruits de micros qu'on enlève de la pince"
        - type: normalize
        - type: compress
          preset: "Lead Vocals"
        - type: normalize

    "19 LEAD VOCALS":
      effects:
        - type: normalize
        - type: compress
          preset: "Brick Wall Master"
          threshold: -13
          label: "Ecrête les bruits de micros qu'on enlève de la pince"
        - type: normalize
        - type: compress
          preset: "Lead Vocals"
        - type: normalize

    "11 DR KICK":
      effects:
        - type: normalize
        - type: compress
          preset: "Kick Drums"
        - type: normalize

    "12 DR HH SD":
      effects:
        - type: normalize
        - type: compress
          preset: "Modern"
        - type: normalize

  mixes:

    - output: "02 GUIT MIX"
      sources:
        - file: "02 GUIT DI"
          pan: 10
        - file: "03 GUIT MIC"
          pan: -5
          gain_db: -15
    - output: "04 KEYS MIX"
      sources:
        - file: "04 KEYS L"
          pan: -100
        - file: "05 KEYS R"
          pan: 100
    - output: "06 RHODES MIX"
      sources:
        - file: "06 RHODES L"
          pan: -100
        - file: "07 RHODES R"
          pan: 100
    - output: "11 DRUMS MIX"
      sources:
        - file: "11 DR KICK"
          pan: 20
        - file: "12 DR HH SD"
          pan: -20
        - file: "10 SAMPLER"
          pan: 0

  exclude:

    - "20 AMBIANCE"

blabla_mix:
  pans:
    "01 BASS": 0
    "02 GUIT MIX": 0
    "04 KEYS MIX": 0
    "06 RHODES MIX": 0
    "18 BACK VOCALS": 0
    "19 LEAD VOCALS": 0
    "11 DRUMS MIX": 0
